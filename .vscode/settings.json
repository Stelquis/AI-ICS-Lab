{
  // ===================================================================
  // VS Code 配置
  // ===================================================================

  // ================================================================
  // 底部状态栏显示项
  // ================================================================

  // CNB Sysmon: CPU 使用率
  "cnb.sysmon.cpu.statusBar.enabled": true,
  // CNB Sysmon: RAM 使用率
  "cnb.sysmon.ram.statusBar.enabled": true,
  // CNB 环境剩余时间
  "cnb.environment.remainingTime.statusBar.enabled": true,
  // Tencent Cloud CodeBuddy (Extension)
  "codingcopilot.statusBar.enabled": true,

  // ================================================================
  // 主题配置
  // ================================================================

  // 文件图标主题
  "workbench.iconTheme": "vs-seti",
  // 默认隐藏次要侧边栏, 留出更多编辑区
  "workbench.secondarySideBar.defaultVisibility": "hidden",

  // ================================================================
  // 编辑器通用配置
  // ================================================================

  // 编辑器字号
  "editor.fontSize": 14,
  // 缩进: 2 空格
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  // 缩略图
  "editor.minimap.enabled": true,
  "editor.minimap.renderCharacters": true,
  "editor.minimap.showSlider": "always",
  "editor.minimap.scale": 1,
  // 失焦时自动保存
  "files.autoSave": "onFocusChange",
  // 保存时自动格式化 (需另装格式化器, 如 Prettier / Black)
  "editor.formatOnSave": true,

  // ================================================================
  // LaTeX Workshop 配置
  // ================================================================

  // 默认编译方案: latexmk + xelatex
  "latex-workshop.latex.recipe.default": "latexmk (xelatex)",
  // 每次构建完成后自动清理中间文件
  "latex-workshop.latex.autoClean.run": "onBuilt",
  // 不在每个 recipe 步骤前清空编译日志
  "latex-workshop.latex.build.clearLog.everyRecipeStep.enabled": false,

  // ================================================================
  // Python 环境
  // ================================================================

  // 指定解释器为镜像内预建的虚拟环境
  "python.defaultInterpreterPath": "/opt/venv/bin/python",
  // 新建终端时自动激活虚拟环境
  "python.terminal.activateEnvironment": true,

  // ================================================================
  // 终端
  // ================================================================

  // 启用终端命令补全建议
  "terminal.integrated.suggest.enabled": true,
  // 向扩展上报 shell 环境变量 (配合 shell integration 使用)
  "terminal.integrated.shellIntegration.environmentReporting": true,

  // ================================================================
  // 远程 / 端口转发
  // ================================================================

  // 关闭自动端口转发, 避免开发服务端口被自动暴露
  "remote.autoForwardPorts": false,
  // 端口检测来源: 终端输出
  "remote.autoForwardPortsSource": "output",

  // ================================================================
  // AI 功能
  // ================================================================

  // 禁用 VS Code 原生 AI (Copilot Chat) 功能, 统一使用 CodeBuddy
  "chat.disableAIFeatures": true,

  // ================================================================
  // 文件关联
  // ================================================================

  // CNB 构建配置文件按 YAML 语法高亮
  "files.associations": {
    "*.cnb.yml": "yaml"
  }
}
